      "prompt": "What does the break statement do inside a loop?",
      "options": [
        "Pauses the loop for 1 second",
        "Exits the loop immediately",
        "Skips the current iteration",
        "Restarts the loop from the beginning"
      ],
      "answerIndex": 1,
      "explanation": "break immediately terminates the innermost loop and transfers control to the code after the loop."
