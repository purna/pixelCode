{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "functions/",
      "node_modules/",
      "**/.*",
      "**/node_modules/**",
      "js/firebase-config.js",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
